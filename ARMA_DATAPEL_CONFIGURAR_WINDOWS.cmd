@echo off
setlocal
title ARMA DATAPEL - CONFIGURACION WINDOWS
echo.
echo ============================================================
echo       ARMA DATAPEL - CONFIGURACION DE ESTE PC
echo ============================================================
echo.
echo Se configura una sola vez por usuario Windows.
